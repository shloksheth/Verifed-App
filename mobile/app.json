{
  "expo": {
    "name": "Verifed",
    "slug": "verifed",
    "version": "1.0.0",
    "scheme": "verifed",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/verifed-mark.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.verifed.dining"
    },
    "android": {
      "package": "com.verifed.dining"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a menu photo to review in Verifed.",
          "cameraPermission": "Photograph a menu to review in Verifed.",
          "microphonePermission": false
        }
      ]
    ],
    "web": {
      "bundler": "metro"
    }
  }
}
